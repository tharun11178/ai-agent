# =============================================================================
# Environment Variables Configuration
# =============================================================================

# Frontend (Static Site): URL of the backend Render Web Service
VITE_API_URL=https://ai-agent-challenge-api.onrender.com

# Backend (Web Service): Production Node Environment & Port
NODE_ENV=production
PORT=10000

# Optional: Dedicated MongoDB URI if switching from SQLite to MongoDB
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/ai-agent
